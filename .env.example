# Existing V4 / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# V5 runtime
NODE_ENV=development
APP_URL=http://localhost:8788
APP_TIMEZONE=Europe/Paris
V5_PORT=8788

# MySQL / MariaDB
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=coach_v5
DATABASE_USER=coach_v5
DATABASE_PASSWORD=

# Auth
# Generate long random values for production. Never commit real secrets.
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Bootstrap admin (used only by npm run create-admin:v5)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Provider secrets will be added in V5-E/F.
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
COROS_REDIRECT_URI=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
