{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router-coros?path=:path*"
    }
  ],
  "functions": {
    "api/router-coros.mjs": {
      "maxDuration": 90
    }
  },
  "outputDirectory": "public"
}
